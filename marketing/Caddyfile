{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv

	encode zstd gzip

	@immutable path /_nuxt/* /fonts/* /brand/* /customers/* /og/* /demo/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	respond /healthz 200

	# Serve /route from /route/index.html directly — no trailing-slash
	# redirect, so URLs match the canonical form used in metadata.
	@dirIndex {
		not path /
		file {path}/index.html
	}
	rewrite @dirIndex {path}/index.html

	handle_errors {
		@notfound expression {http.error.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
	}

	file_server
}
