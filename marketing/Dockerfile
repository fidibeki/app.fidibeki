FROM node:24-alpine AS build

ARG NUXT_PUBLIC_SITE_URL=https://fidibeki.com
ARG NUXT_PUBLIC_APP_URL=https://fidibeki.com
ARG NUXT_PUBLIC_DEMO_SCHEDULER_URL=https://cal.eu/acidiney.dias-fidibeki/30min

ARG NUXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
ARG NUXT_PUBLIC_UMAMI_WEBSITE_ID=""

ARG NUXT_PUBLIC_WIDGET_SCRIPT_URL=https://widget.fidibeki.com/v1/loader.js
ARG NUXT_PUBLIC_WIDGET_KEY=""
ARG NUXT_PUBLIC_WIDGET_TESTIMONIAL_KEY=""
ARG NUXT_PUBLIC_WIDGET_CONSENT_LOCALE=en
ARG NUXT_PUBLIC_WIDGET_ANALYTICS_NOTICE_VERSION=2026-07
ARG NUXT_PUBLIC_WIDGET_REPLAY_NOTICE_VERSION=2026-07

ARG NUXT_PUBLIC_STATUS_PAGE_URL=https://status.fidibeki.com
ARG NUXT_PUBLIC_STATUS_PAGE_ID=""

ENV NUXT_PUBLIC_SITE_URL=${NUXT_PUBLIC_SITE_URL} \
  NUXT_PUBLIC_APP_URL=${NUXT_PUBLIC_APP_URL} \
  NUXT_PUBLIC_DEMO_SCHEDULER_URL=${NUXT_PUBLIC_DEMO_SCHEDULER_URL} \
  NUXT_PUBLIC_UMAMI_SCRIPT_URL=${NUXT_PUBLIC_UMAMI_SCRIPT_URL} \
  NUXT_PUBLIC_UMAMI_WEBSITE_ID=${NUXT_PUBLIC_UMAMI_WEBSITE_ID} \
  NUXT_PUBLIC_WIDGET_SCRIPT_URL=${NUXT_PUBLIC_WIDGET_SCRIPT_URL} \
  NUXT_PUBLIC_WIDGET_KEY=${NUXT_PUBLIC_WIDGET_KEY} \
  NUXT_PUBLIC_WIDGET_CONSENT_LOCALE=${NUXT_PUBLIC_WIDGET_CONSENT_LOCALE} \
  NUXT_PUBLIC_WIDGET_ANALYTICS_NOTICE_VERSION=${NUXT_PUBLIC_WIDGET_ANALYTICS_NOTICE_VERSION} \
  NUXT_PUBLIC_WIDGET_REPLAY_NOTICE_VERSION=${NUXT_PUBLIC_WIDGET_REPLAY_NOTICE_VERSION} \
  NUXT_PUBLIC_STATUS_PAGE_URL=${NUXT_PUBLIC_STATUS_PAGE_URL} \
  NUXT_PUBLIC_STATUS_PAGE_ID=${NUXT_PUBLIC_STATUS_PAGE_ID} \
  NUXT_PUBLIC_WIDGET_TESTIMONIAL_KEY=${NUXT_PUBLIC_WIDGET_TESTIMONIAL_KEY}

WORKDIR /src

RUN npm install --global pnpm@11.15.1

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY marketing/package.json marketing/package.json

RUN pnpm install --frozen-lockfile --filter @fidibeki/marketing...

COPY marketing marketing

RUN pnpm --filter @fidibeki/marketing build


FROM caddy:2-alpine

COPY marketing/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/marketing/.output/public /srv

EXPOSE 8080