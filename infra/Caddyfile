{
	auto_https off
}

:80 {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	@widget host widget.localhost widget.fidibeki.com {$WIDGET_HOST:widget.invalid}
	handle @widget {
		route {
			@source_maps path_regexp sourceMap \.map$
			respond @source_maps 404

			@immutable_assets path /v1/assets/*
			handle @immutable_assets {
				root * /srv/widget
				header {
					Access-Control-Allow-Origin "*"
					Cache-Control "public, max-age=31536000, immutable"
					Cross-Origin-Resource-Policy "cross-origin"
					X-Content-Type-Options "nosniff"
				}
				file_server
			}

			@widget_entries path /v1/*.js /v1/manifest.json
			handle @widget_entries {
				root * /srv/widget
				header {
					Access-Control-Allow-Origin "*"
					Cache-Control "public, max-age=300, must-revalidate"
					Cross-Origin-Resource-Policy "cross-origin"
					X-Content-Type-Options "nosniff"
				}
				file_server
			}

			reverse_proxy {$WIDGET_API_UPSTREAM:api:8080}
		}
	}

	# A stand-in for a customer's marketing site, served from its own host so the
	# testimonials embed crosses a genuine origin boundary. Serving it from the
	# app host would let CORS and CORP pass by accident.
	@mocksite host demo.localhost
	handle @mocksite {
		root * /srv/mocksite
		header {
			Cache-Control "no-store"
			X-Content-Type-Options "nosniff"
		}
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}
}
