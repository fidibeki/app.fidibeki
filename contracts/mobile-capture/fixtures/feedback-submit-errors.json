{
  "cases": [
    {
      "status": 401,
      "body": {
        "error": {
          "code": "invalid_token",
          "message": "Bearer fmc_private_session_token must not escape"
        }
      },
      "expected_code": "access_denied",
      "retryable": false
    },
    {
      "status": 404,
      "body": {
        "error": {
          "code": "not_found",
          "message": "The chart labels are difficult to read"
        }
      },
      "expected_code": "access_denied",
      "retryable": false
    },
    {
      "status": 410,
      "body": {
        "error": {
          "code": "session_expired",
          "message": "fmc_expired_private_session_token"
        }
      },
      "expected_code": "session_expired",
      "retryable": false
    },
    {
      "status": 409,
      "body": {
        "error": {
          "code": "configuration_changed",
          "message": "mobile capture configuration changed"
        }
      },
      "expected_code": "configuration_changed",
      "retryable": false
    },
    {
      "status": 422,
      "body": {
        "error": {
          "code": "validation_failed",
          "message": "feedback is invalid",
          "details": [
            {
              "field": "responses.feedback",
              "message": "is required"
            }
          ]
        }
      },
      "expected_code": "validation_error",
      "retryable": false
    },
    {
      "status": 429,
      "body": {
        "error": {
          "code": "rate_limited",
          "message": "slow down"
        }
      },
      "expected_code": "network_error",
      "retryable": true
    },
    {
      "status": 503,
      "body": {
        "error": {
          "code": "service_unavailable",
          "message": "try again later"
        }
      },
      "expected_code": "network_error",
      "retryable": true
    }
  ]
}
