{
  "name": "fidibeki",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "test:live-support": "bash scripts/test-live-support.sh",
    "build:widget": "pnpm --filter @fidibeki/widget build",
    "build:mobile": "pnpm --filter @fidibeki/mobile build",
    "build:web": "pnpm --filter @fidibeki/web build",
    "build:marketing": "pnpm --filter @fidibeki/marketing build",
    "dev:marketing": "pnpm --filter @fidibeki/marketing dev",
    "test:marketing": "pnpm --filter @fidibeki/marketing test",
    "test:marketing:e2e": "pnpm --filter @fidibeki/marketing test:e2e",
    "typecheck:marketing": "pnpm --filter @fidibeki/marketing typecheck",
    "dev:web": "pnpm --filter @fidibeki/web dev",
    "test:widget": "pnpm --filter @fidibeki/widget test",
    "test:mobile": "pnpm --filter @fidibeki/mobile test",
    "test:widget:e2e": "pnpm --filter @fidibeki/widget test:e2e",
    "test:web": "pnpm --filter @fidibeki/web test",
    "test:web:e2e": "pnpm --filter @fidibeki/web test:e2e",
    "typecheck:web": "pnpm --filter @fidibeki/web typecheck",
    "typecheck:mobile": "pnpm --filter @fidibeki/mobile typecheck"
  }
}
