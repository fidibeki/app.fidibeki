{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile",
    "watchPatterns": ["backend/**", "infra/migrations/**"]
  },
  "deploy": {
    "preDeployCommand": ["fidibeki-api migrate up"],
    "startCommand": "fidibeki-api worker",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 15
  }
}
