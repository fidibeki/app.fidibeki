# Application
APP_ENV=local
APP_VERSION=dev
LOG_LEVEL=debug
HTTP_ADDRESS=:8080
# Managed runtimes can inject PORT instead; HTTP_ADDRESS takes precedence when both are set.
# PORT=8080
BASE_DOMAIN=localhost
PUBLIC_BASE_URL=http://api.localhost:8088
# Browser-facing origin for tenant URLs (SAML entity ID, assertion consumer, and
# post-login redirects). Defaults to PUBLIC_BASE_URL. Locally the Nuxt dev server
# terminates these, so it points at its port instead of the API's.
WEB_PUBLIC_BASE_URL=http://api.localhost:3000
# Exact browser origin for the separately deployed platform backoffice. The
# platform magic-link flow refuses caller-provided redirects and uses this only.
PLATFORM_BACKOFFICE_URL=http://admin.localhost:3001
READINESS_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s

# Database
# Plaintext database transport is permitted only because APP_ENV is local.
DATABASE_URL_APP=postgres://fidibeki_app:fidibeki-app-local@localhost:6432/fidibeki?sslmode=disable
DATABASE_URL_ADMIN=postgres://fidibeki_admin:fidibeki-admin-local@localhost:6432/fidibeki?sslmode=disable
DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:5433/fidibeki?sslmode=disable
DATABASE_APP_MAX_CONNS=10
DATABASE_ADMIN_MAX_CONNS=5
MIGRATIONS_PATH=../infra/migrations

# Redis
# Plaintext Redis transport is permitted only because APP_ENV is local.
REDIS_URL=redis://localhost:6380/0
# Optional PEM CA for a private rediss:// certificate; never combine with redis://.
REDIS_CA_CERT=

# S3-compatible storage. MinIO is local/test-only; production uses a managed S3 provider.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fidibeki
S3_ACCESS_KEY=fidibeki-local
S3_SECRET_KEY=fidibeki-local-secret
S3_AUTO_CREATE_BUCKET=true

# Authentication
JWT_SECRET=local-only-jwt-secret-change-before-production
# Set the same random value as NUXT_INTERNAL_PROXY_SECRET on the web service.
INTERNAL_PROXY_SECRET=local-only-internal-proxy-secret-change-me
# Comma-separated ingress proxy networks allowed to supply X-Forwarded-For. Empty trusts none.
TRUSTED_PROXY_CIDRS=
# Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Encrypts member TOTP secrets at rest. Must differ from the integration key.
TWO_FACTOR_ENCRYPTION_KEY=ZmVkY2JhOTg3NjU0MzIxMGZlZGNiYTk4NzY1NDMyMTA=
AUTH_ACCESS_TOKEN_TTL=10m
AUTH_MAGIC_LINK_TTL=10m
AUTH_REFRESH_TOKEN_TTL=720h

# Billing. Leave empty locally to run with billing endpoints unavailable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_SCALE_YEARLY=

# Cloudflare Turnstile. Local mode bypasses verification when the secret is empty.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Email and queue
EMAIL_DRIVER=capture
EMAIL_CAPTURE_DIR=/tmp/fidibeki-emails
# Local-only signing key. Generate an environment-specific value with: openssl rand -base64 32
EMAIL_TASK_SIGNING_KEY=ZWVlZWVlZWVlZWVlZWVlZWVlZWVlZWVlZWVlZWVlZWU=
# Verification-only key used temporarily during rotation.
EMAIL_TASK_PREVIOUS_SIGNING_KEY=
EMAIL_QUEUE_CONCURRENCY=20
RESEND_API_KEY=
RESEND_AUTH_FROM=Fidibeki <auth@fidibeki.com>
# Enable the founder welcome only after this sender address is verified with Resend.
RESEND_WELCOME_FROM=Acidiney from Fidibeki <acidiney.dias@fidibeki.com>
RESEND_WELCOME_REPLY_TO=acidiney.dias@fidibeki.com
RESEND_WEBHOOK_SECRET=
REPORTER_UNSUBSCRIBE_TTL=2160h

# AI processing. The worker keeps jobs retryable when the API key is empty locally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_RPM=15
AI_QUEUE_CONCURRENCY=3
AI_DAILY_REQUEST_LIMIT=5000
AI_PROJECT_DAILY_REQUEST_LIMIT=2000
AI_RECONCILE_INTERVAL=5m
DIGEST_MEMBERS_PER_RUN=200

# Observability
SENTRY_DSN=

# Slack one-click install. All three or none: leaving them empty keeps the
# manual webhook-URL path working and hides the install button.
# SLACK_REDIRECT_URL must exactly match a redirect URL registered on the Slack app.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URL=

# Nuxt service
NUXT_API_UPSTREAM=http://api.localhost:8088
# Must match INTERNAL_PROXY_SECRET on the API service.
NUXT_INTERNAL_PROXY_SECRET=local-only-internal-proxy-secret-change-me
# Server-only trusted host used by the API proxy.
NUXT_BASE_DOMAIN=localhost
# Browser-visible host used for workspace and widget URLs.
NUXT_PUBLIC_BASE_DOMAIN=localhost
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# Publishable widget key for the project the app reports its own feedback into.
# It is rendered into every page, and the API still checks the browser Origin
# against that project's allowed domains, so it is public rather than secret —
# but it names a real project, so it lives here and not in a config default.
# Unset means the app runs without its own widget.
NUXT_PUBLIC_WIDGET_KEY=

# Widget edge service
WIDGET_API_UPSTREAM=api:8080
API_UPSTREAM=api:8080

# CI-only release variables. Store tokens in the CI secret manager, never in this file.
SENTRY_ORG=
SENTRY_API_PROJECT=
SENTRY_WEB_PROJECT=
SENTRY_WIDGET_PROJECT=
SENTRY_AUTH_TOKEN=
