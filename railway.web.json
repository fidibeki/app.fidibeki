{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "web/Dockerfile",
    "watchPatterns": ["web/**", "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml"]
  },
  "deploy": {
    "healthcheckPath": "/web-healthz",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": "30",
    "drainingSeconds": "15"
  }
}
